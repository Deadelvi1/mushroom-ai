# 🍄 MUSHROOM AI - ENVIRONMENT CONFIGURATION
# Copy ini ke .env dan adjust sesuai kebutuhan
# Jangan commit .env ke repository - hanya .env.example

# === FLASK CONFIGURATION ===
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_APP=app.py
SECRET_KEY=your-super-secret-key-change-this

# === SERVER CONFIGURATION ===
HOST=0.0.0.0
PORT=5000
WORKERS=4

# === MODEL CONFIGURATION ===
MODEL_PATH=model/model.pkl
ENCODER_PATH=model/encoder.pkl

# === API CONFIGURATION ===
API_MAX_WORKERS=4
API_TIMEOUT=120

# === DAGSHUB + MLFLOW (OPTIONAL) ===
DAGSHUB_USERNAME=your-username
DAGSHUB_REPO=mushroom-ai
DAGSHUB_TOKEN=your-dagshub-token
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=mushroom-classification

# === RAILWAY DEPLOYMENT ===
# Set automatically by Railway
# RAILWAY_ENVIRONMENT_ID=xxxxx
# RAILWAY_TOKEN=xxxxx

# === CLOUD STORAGE (OPTIONAL for large models) ===
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# === LOOKER STUDIO (OPTIONAL) ===
LOOKER_DASHBOARD_ID=your-dashboard-id
LOOKER_API_KEY=your-api-key
